# Copy to `.env` for local development. Expo only exposes EXPO_PUBLIC_* to the
# app, and inlines them at build time — so a change here needs a rebuild, not
# just a restart. These are *public* client values: never put a service-role
# key or a model API key in this app. In CI these same names are repository
# secrets, read by .github/workflows/android.yml.

# backend-render — the always-on core API, and the only backend this app must
# be pointed at. Auth, the library, the calendar, health, notifications and
# schedules all come through it; the laptop agent's address is discovered
# through it too.
#
# The `/api/v1` suffix is optional — the client appends it when missing, so the
# bare host works just as well.
#   Local:      http://10.0.2.2:8080/api/v1   (10.0.2.2 = the host, from the emulator)
#   Production: https://<your-service>.onrender.com
EXPO_PUBLIC_API_URL=

# backend-local — an optional fixed address for the laptop agent (assistant
# chat). Normally left empty: the agent's quick-tunnel URL changes on every
# start, so it is discovered from node_status through Render instead. Set this
# only for a stable tunnel or for development against a laptop on the same
# network.
EXPO_PUBLIC_AGENT_URL=

# The deployed web app the shell loads (docs/ANDROID_UPGRADE.md). Since the
# Android upgrade the phone is a thin WebView shell around this URL — the UI is
# the web app itself, so there is one codebase and one design. Required for the
# shell; with it empty the app shows a setup screen.
#   Local:      http://10.0.2.2:8443   (the Vite dev server, from the emulator)
#   Production: https://<your-app>.vercel.app
EXPO_PUBLIC_WEB_URL=

# Which UI to run. Defaults to the WebView shell. Set to `native` (or 0/false/
# off) to fall back to the legacy hand-built native screens, which are kept one
# release behind this flag until the shell is proven on a real device.
EXPO_PUBLIC_SHELL=
