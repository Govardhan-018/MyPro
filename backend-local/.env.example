# backend-local — the personal agent on YOUR laptop.
# This is the only machine that ever holds the model API key.
#
# Copy to `.env` and fill in. NEVER put real values in this file —
# .env.example is committed to git, .env is not.

NODE_ENV=production
PORT=8787

# Exact origins allowed to call this agent (your web app + local dev).
CORS_ORIGINS=https://<your-app>.vercel.app,http://localhost:8443

# ---- Supabase (direct data access) ----
SUPABASE_URL=https://<project>.supabase.co
# Public key (sb_publishable_…) — used with the caller's JWT, RLS applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — bypasses RLS. Server only, never in a client.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# ---- node→node ----
# SAME value as backend-render/.env. Generate: openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=

# This machine's public HTTPS origin, heartbeated into node_status so render
# and the web app can find it. Leave blank — start-agent.bat sets it from the
# Cloudflare quick tunnel on every start.
PUBLIC_BASE_URL=

# ---- the LLM (never leaves this machine) ----
# Groq free key: https://console.groq.com/keys
GROQ_API_KEY=
ASSISTANT_MODEL=openai/gpt-oss-120b

# ---- the agent core (Phase 19) ----
# Optional: a cheaper/smaller model for the two classification-shaped calls —
# routing a request to capabilities, and planning it. Leave blank to use
# ASSISTANT_MODEL for everything (no behaviour change).
ASSISTANT_ROUTER_MODEL=
ASSISTANT_PLANNER_MODEL=


# ---- the clock's worker (Phase 11) ----
# This machine drains anything whose next_run_at has passed: on boot, and
# every minute while it is awake. Render's free instance is allowed to sleep,
# so this is where scheduled work actually runs.
SCHEDULER_ENABLED=true
# How late a RECURRING job may be and still fire, in minutes. The laptop may
# have been shut for days, and "here is your day" at 11pm is not a morning
# brief — anything later is skipped to its next occurrence. One-shots always
# fire. 0 disables the check.
SCHEDULER_STALE_MINUTES=120

# ---- Web Push (Phase 6.2) — optional ----
# Reaches a browser whose tab is closed. Generate a pair with:
#   npx web-push generate-vapid-keys
# The PUBLIC key must also go in frontend/.env as VITE_WEB_PUSH_PUBLIC_KEY.
# Leave blank to turn the channel off.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com

# ---- the internet (Phase 20) ----
# ALL OPTIONAL. With every one of these blank, research still works on the
# free keyless providers: Wikipedia (search), GDELT (news), TheSportsDB's
# public test key (fixtures) and Open-Meteo (weather). Adding a key promotes a
# better provider in that chain. See docs/RESEARCH_PROVIDERS.md.

# Search. tavily.com (~1,000 credits/mo) and brave.com/search/api (~2,000 q/mo).
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# A SearXNG instance you trust — free, no key, no quota. Origin only.
SEARXNG_BASE_URL=

# News. open-platform.theguardian.com is free, instant and ~12,000 calls/day —
# it is the one worth getting. newsdata.io is ~200 req/day.
# Without either, news falls back to GDELT, which is keyless but rate-limits
# to one request per 5s and frequently answers 429.
GUARDIAN_API_KEY=
NEWSDATA_API_KEY=
# Free, keyless news from feeds YOU choose. Comma-separated, up to 8. e.g.
# https://feeds.bbci.co.uk/news/world/rss.xml,https://www.theguardian.com/world/rss
NEWS_RSS_FEEDS=

# Sport. Blank uses TheSportsDB's public test key, which works but is throttled.
THESPORTSDB_API_KEY=

# Hosted scraping, used only when our own fetch cannot read a page (JS-rendered).
FIRECRAWL_API_KEY=

# Provider order, best first. Blank = the built-in order, filtered to what is
# configured. An unknown id is logged and skipped.
#   search:  tavily,brave,searxng,wikipedia
#   news:    guardian,newsdata,gdelt
#   sports:  thesportsdb
#   extract: native,firecrawl
#   weather: open-meteo
RESEARCH_SEARCH_PROVIDERS=
RESEARCH_NEWS_PROVIDERS=
RESEARCH_SPORTS_PROVIDERS=
RESEARCH_EXTRACT_PROVIDERS=
RESEARCH_WEATHER_PROVIDERS=

# Fetch limits. Never the user's details in the user agent.
RESEARCH_USER_AGENT=
RESEARCH_MAX_FETCH_BYTES=1500000
RESEARCH_FETCH_TIMEOUT_MS=12000
RESEARCH_HOST_DELAY_MS=1000
RESEARCH_MAX_PAGE_CHARS=6000
# Cache lifetimes. 0 disables caching (not recommended on free tiers).
RESEARCH_CACHE_TTL_MINUTES=180
RESEARCH_WEATHER_TTL_MINUTES=30

# ---- limits ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ---- reaching render (Phase 7.6) ----
# backend-render's API root. Needed only so the companion can really send an
# email once you approve it: render holds the Gmail tokens and the key that
# decrypts them, and this machine never gets a copy. Leave blank and
# send_email declines clearly instead of failing.
RENDER_API_URL=https://<your-service>.onrender.com/api/v1
