# backend-local — the personal agent on YOUR laptop.
# This is the only machine that ever holds the model API key.
#
# Copy to `.env` and fill in. NEVER put real values in this file —
# .env.example is committed to git, .env is not.

NODE_ENV=production
PORT=8787

# Exact origins allowed to call this agent (your web app + local dev).
CORS_ORIGINS=https://<your-app>.vercel.app,http://localhost:8443

# ---- Supabase (direct data access) ----
SUPABASE_URL=https://<project>.supabase.co
# Public key (sb_publishable_…) — used with the caller's JWT, RLS applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — bypasses RLS. Server only, never in a client.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# ---- node→node ----
# SAME value as backend-render/.env. Generate: openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=

# This machine's public HTTPS origin, heartbeated into node_status so render
# and the web app can find it. Leave blank — start-agent.bat sets it from the
# Cloudflare quick tunnel on every start.
PUBLIC_BASE_URL=

# ---- the LLM (never leaves this machine) ----
# Google AI Studio free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
ASSISTANT_MODEL=gemini-3.8-flash

# ---- limits ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
