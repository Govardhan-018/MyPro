# backend-render — always-on core API. Set these in the Render dashboard
# (Environment tab); keep a local copy only for `npm run dev`.
#
# NEVER put real values in this file — .env.example is committed to git.

NODE_ENV=production
PORT=8080

# Exact origins allowed to call this API (no wildcards).
CORS_ORIGINS=https://<your-app>.vercel.app,http://localhost:8443

# ---- Supabase ----
SUPABASE_URL=https://<project>.supabase.co
# Public key (sb_publishable_…) — used with the caller's JWT, RLS applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — bypasses RLS. Never in any client bundle.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# ---- laptop agent ----
# Shared secret for render→laptop calls. SAME value in backend-local/.env.
# Generate: openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=
# Usually leave blank: the laptop publishes its own (ephemeral) URL into
# node_status on every start. Only set this for a fixed/named tunnel.
LOCAL_AGENT_URL=

# ---- crypto ----
# Encrypts Gmail OAuth tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- Gmail (Phase 7) ----
# An OAuth client from https://console.cloud.google.com/apis/credentials
# (type: Web application). Scopes needed: gmail.readonly, gmail.send, openid,
# email.
#
# ⚠️ Leave the OAuth app in "Testing" and Google issues refresh tokens that
# expire after 7 DAYS — the mailbox silently disconnects every week. Fixing
# that means publishing the app and passing Google's verification review for
# the restricted gmail.readonly scope. Free, but slow: start it early.
#
# Leave all three blank and the Mail panel says "not available" instead of
# offering a button that cannot work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the console byte for byte, including /api/v1.
GOOGLE_REDIRECT_URI=https://<your-service>.onrender.com/api/v1/gmail/callback
# Where the callback returns the browser once a mailbox is connected.
APP_URL=https://<your-app>.vercel.app

# ---- the clock (Phase 11) ----
# OFF here. Render's free instance sleeps after ~15 min of inactivity, so an
# in-process cron silently stops firing. The drain loop lives on the laptop
# (backend-local) and the on-time firing is the phone's OS.
# Set to true ONLY for local development, or on a paid always-on instance.
# Never run both loops at once — they race for the same rows and double-send.
SCHEDULER_ENABLED=false

# ---- messaging channels ----
# Telegram was dropped (Phase 6.3) — the in-app chat is the channel.
TELEGRAM_BOT_TOKEN=
# Web Push (Phase 6.2). The PUBLIC key is served to browsers by GET /me/push
# so nothing is baked into a bundle — set it here for real. The PRIVATE key
# lives only in backend-local/.env, because since Phase 11 the laptop is the
# half that actually sends. Generate a pair: npx web-push generate-vapid-keys
WEB_PUSH_PUBLIC_KEY=
# Unused here unless SCHEDULER_ENABLED=true for local development.
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com

# ---- limits ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
