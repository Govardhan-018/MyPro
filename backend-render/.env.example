# backend-render — always-on core API. Set these in the Render dashboard
# (Environment tab); keep a local copy only for `npm run dev`.
#
# NEVER put real values in this file — .env.example is committed to git.

NODE_ENV=production
PORT=8080

# Exact origins allowed to call this API (no wildcards).
CORS_ORIGINS=https://<your-app>.vercel.app,http://localhost:8443

# ---- Supabase ----
SUPABASE_URL=https://<project>.supabase.co
# Public key (sb_publishable_…) — used with the caller's JWT, RLS applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) — bypasses RLS. Never in any client bundle.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json

# ---- laptop agent ----
# Shared secret for render→laptop calls. SAME value in backend-local/.env.
# Generate: openssl rand -base64 48
INTERNAL_SERVICE_TOKEN=
# Usually leave blank: the laptop publishes its own (ephemeral) URL into
# node_status on every start. Only set this for a fixed/named tunnel.
LOCAL_AGENT_URL=

# ---- crypto ----
# Encrypts Gmail OAuth tokens at rest. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---- messaging channels (optional until wired) ----
TELEGRAM_BOT_TOKEN=
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com

# ---- limits ----
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
