# Copy to `.env` and fill in. Vite only exposes VITE_* to the browser.
# These are *public* client values — never put service-role keys or
# LLM API keys here; those live only in the backends' .env files.

VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_ANON_KEY=

# backend-render — always-on core API (library, calendar, tasks, health,
# notifications, schedules, gmail, node status). No trailing slash.
# Local:      http://localhost:8080/api/v1
# Production: https://<your-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# backend-local — the personal agent on your laptop (assistant chat).
# Must be HTTPS in production (Cloudflare Tunnel), or the Vercel page
# cannot call it. No trailing slash.
# Local:      http://localhost:8787/api/v1
# Production: https://<your-tunnel-host>/api/v1
VITE_AGENT_URL=http://localhost:8787/api/v1

# ---- text recognition for scanned PDFs (Phase 10.4) — all optional ----
# A PDF with no text layer is read on this device with Tesseract (WebAssembly).
# The worker script is served from this app's own origin; the core WASM and the
# language data fall back to the library's own CDN defaults unless you point
# these at your own copies. The language data is a few megabytes, fetched once
# and then cached by the browser.
#   VITE_OCR_CORE_PATH   a directory serving tesseract-core*.wasm.js
#   VITE_OCR_LANG_PATH   a directory serving <lang>.traineddata.gz
VITE_OCR_CORE_PATH=
VITE_OCR_LANG_PATH=
# Tesseract language code. 'eng+deu' style combinations work.
VITE_OCR_LANGUAGE=eng
